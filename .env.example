# Server configuration
PORT=5000
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# Audit engine settings
REQUEST_TIMEOUT_MS=15000
MAX_REDIRECTS=5
USER_AGENT=CipherGate/1.0 (+https://github.com/mahesha8097/ciphergate)

# Enable/disable Puppeteer-based rendering (headless browser).
# When false, the audit falls back to a static HTML fetch (axios + cheerio),
# which works in most sandboxed / low-resource environments.
ENABLE_PUPPETEER=false

# Reports
REPORTS_DIR=./reports
